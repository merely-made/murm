; Authored simulation envelope; not COSE or a physical radio protocol.
; RFC 8949 core deterministic encoding applies in addition to this schema.

envelope = [body: bstr, signature: bstr .size 64]

manifest = [
  version: 1,
  kind: 0,
  namespace: bstr .size 32,
  generation: uint,
  publish-slot: uint,
  expiry-slot: uint,
  oti: bstr .size 12,
  object-blake3: bstr .size 32,
  channels: 1..8,
  manifest-interval: uint,
  repair-floor: 0..8
]

symbol = [
  version: 1,
  kind: 1,
  namespace: bstr .size 32,
  generation: uint,
  manifest-body-blake3: bstr .size 32,
  raptorq-packet: bstr
]

; Body is the exact deterministic encoding of either manifest or symbol.
; RaptorQ packet is the four-octet SBN/ESI payload ID followed by one full
; T-octet symbol. Receiver validation supplies OTI-dependent length/work bounds.
